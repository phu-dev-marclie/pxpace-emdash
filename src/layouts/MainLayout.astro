        </li>
        <li class="w-footer__social-item w-footer__social-item--alt" builder-data-element="text">
          <SocialLink label="Support">
            <svg class="w-social-link__icon" builder-data-element="svg" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3.5a8.5 8.5 0 0 0-7.4 12.7L3.5 20.5l4.4-1.1A8.5 8.5 0 1 0 12 3.5Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"></path></svg>

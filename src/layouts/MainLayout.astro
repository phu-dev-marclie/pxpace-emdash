        </li>
        <li class="w-footer__social-item" builder-data-element="text"></li>
      </ul>
    </div>
    <div class="w-footer__legal" builder-data-element="div" data-brx="div">
      <div class="w-footer__legal-cell" builder-data-element="flex" data-brx="block">
        <p class="w-footer__legal-text" builder-data-element="text">PXpace. <span class="w-footer__legal-muted">©All rights reserved.</span> · Sitemap</p>

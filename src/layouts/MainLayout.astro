---
// generated by sitereal — the layout of a template: "Main"
import NavLinkButton from '../components/NavLinkButton.astro';
import NavLinkA from '../components/NavLinkA.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ButtonOutline from '../components/ButtonOutline.astro';
import ButtonSecondary from '../components/ButtonSecondary.astro';
import MegaMenuItem from '../components/MegaMenuItem.astro';
import ButtonPrimary from '../components/ButtonPrimary.astro';
import ButtonGhost from '../components/ButtonGhost.astro';
import CardGuarantee from '../components/CardGuarantee.astro';
import FieldSubscribe from '../components/FieldSubscribe.astro';
import FooterMenuColumn from '../components/FooterMenuColumn.astro';
import SocialLink from '../components/SocialLink.astro';
---
<header class="w-header" builder-data-element="section" data-surface="default" data-brx="section">
  <div class="w-header__container" builder-data-element="container" data-brx="container">
    <div class="w-header__bar" builder-data-element="flex" data-brx="block">
      <a class="w-header__logo" builder-data-element="link" href="#">
        <img class="w-header__logo-image w-header__logo-image--light" builder-data-element="image" alt="PXpace" height="28" src="/brand/pxpace-official-logo.svg" width="117" />
        <img class="w-header__logo-image w-header__logo-image--dark" builder-data-element="image" alt="PXpace" height="28" src="/brand/pxpace-official-logo-white.svg" width="117" />
      </a>
      <nav class="w-header__menu" builder-data-element="div" aria-label="Main">
        <NavLinkButton megaTrigger="solutions" label="Solutions" />
        <NavLinkA link="#" label="Pricing" />
        <NavLinkButton label="Providers" />
        <NavLinkButton label="Features" />
        <NavLinkButton label="Integrations" />
        <NavLinkButton label="Resources" />
      </nav>
      <div class="w-header__actions" builder-data-element="flex" data-brx="block">
        <ThemeToggle />
        <ButtonOutline link="#" variant="w-button-outline--small" label="Book a demo" showIcon />
        <ButtonSecondary link="#" variant="w-button-secondary--small" label="Login" />
      </div>
    </div>
    <div class="w-header__mega" builder-data-element="div" data-mega="solutions">
      <div class="w-header__mega-panel" builder-data-element="div" data-brx="div">
        <div class="w-header__mega-main" builder-data-element="div" data-brx="div">
          <p class="w-header__mega-heading" builder-data-element="text">Hosting by use case</p>
          <ul class="w-header__mega-grid" builder-data-element="list">
            <li class="w-header__mega-cell" builder-data-element="text">
              <MegaMenuItem link="#" icon="https://xcloud.host/_landing/mega-menu/icons/wordpress.svg" title="WordPress Hosting" description="Fast, safe WordPress and WooCommerce." />
            </li>
            <li class="w-header__mega-cell" builder-data-element="text">
              <MegaMenuItem link="#" icon="https://xcloud.host/_landing/home/hosting-types/docker.svg" title="Docker Hosting" description="Run any app in a container." />
            </li>
            <li class="w-header__mega-cell" builder-data-element="text">
              <MegaMenuItem link="#" icon="https://xcloud.host/_landing/home/hosting-types/nodejs.svg" title="Node.js Hosting" description="Deploy JavaScript apps from Git." />
            </li>
            <li class="w-header__mega-cell" builder-data-element="text">
              <MegaMenuItem link="#" icon="https://xcloud.host/_landing/home/hosting-types/php.svg" title="Laravel Hosting" description="PHP apps, ready to run." />
            </li>
          </ul>
        </div>
        <div class="w-header__mega-promos" builder-data-element="div" data-brx="div">
          <a class="w-header__mega-promo" builder-data-element="link" href="#">
            <img class="w-header__mega-promo-image" builder-data-element="image" alt="" src="https://xcloud.host/_landing/mega-menu/promo-solutions.png" />
          </a>
        </div>
      </div>
    </div>
  </div>
</header>
<main builder-data-element="site-content" id="main">
  <slot />
</main>
<footer class="w-footer" builder-data-element="section" data-surface="base" data-brx="section">
  <div class="w-footer__container" builder-data-element="container" data-brx="container">
    <div class="w-footer__cta" builder-data-element="flex" data-animate="" data-brx="block">
      <div class="w-footer__cta-visual" builder-data-element="div" data-brx="div">
        <img class="w-footer__cta-image" builder-data-element="image" alt="" src="https://xcloud.host/_landing/footer/cta-orbit.png" />
      </div>
      <div class="w-footer__cta-copy" builder-data-element="flex" data-brx="block">
        <h2 class="w-heading-l" builder-data-element="heading">Real Humans. Expert Engineers. Live Chat. Always-Online, 24/7/365.</h2>
        <p class="w-footer__cta-text" builder-data-element="text">Our expert support team is always here when you need us. With years of hosting experience, we put customers first – from product decisions to every chat and support ticket.</p>
      </div>
      <div class="w-footer__cta-actions" builder-data-element="flex" data-brx="block">
        <ButtonPrimary link="#" label="Migrate For Free" />
        <ButtonGhost link="#" label="Talk To Us" />
      </div>
    </div>
    <div class="w-footer__guarantees" builder-data-element="div" data-brx="div">
      <CardGuarantee icon={"<rect fill=\"none\" height=\"10.5\" rx=\"1.8\" stroke=\"currentColor\" stroke-width=\"1.125\" width=\"13.5\" x=\"2.25\" y=\"4.5\"></rect><path d=\"M11.5 9.75h4.25M2.25 7.5h13.5\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.125\"></path>"} title="14-Day Money-Back Guarantee" text="Bring your own server, refundable within 14 days." />
      <CardGuarantee icon={"<rect fill=\"none\" height=\"13.5\" rx=\"1.8\" stroke=\"currentColor\" stroke-width=\"1.125\" width=\"12\" x=\"3\" y=\"2.25\"></rect><path d=\"m7 7.5 4 4m0-4-4 4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.125\"></path>"} title="Cancel Anytime" text="Change or cancel your plan whenever needed." />
      <CardGuarantee icon={"<path d=\"M9 1.9 3.4 4v4.4c0 3.5 2.4 6.4 5.6 7.6 3.2-1.2 5.6-4.1 5.6-7.6V4L9 1.9z\" fill=\"none\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"1.125\"></path><path d=\"m6.6 9 1.7 1.7 3.2-3.4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.125\"></path>"} title="Totally Risk Free" text="Transparent pricing with zero hidden fees, guaranteed." />
      <CardGuarantee icon={"<path d=\"M3 10.5V9a6 6 0 0 1 12 0v1.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.125\"></path><rect fill=\"none\" height=\"4.5\" rx=\"1\" stroke=\"currentColor\" stroke-width=\"1.125\" width=\"3\" x=\"2.25\" y=\"10\"></rect><rect fill=\"none\" height=\"4.5\" rx=\"1\" stroke=\"currentColor\" stroke-width=\"1.125\" width=\"3\" x=\"12.75\" y=\"10\"></rect>"} title="24/7 support" text="Real engineers ready to help, always online." />
    </div>
    <div class="w-footer__brand" builder-data-element="flex" data-brx="block">
      <div class="w-footer__intro" builder-data-element="flex" data-brx="block">
        <img class="w-footer__logo" builder-data-element="image" alt="PXpace" height="28" src="/brand/pxpace-official-logo-white.svg" width="117" />
        <p class="w-footer__tagline" builder-data-element="text">PXpace is the future of cloud hosting and server management for WordPress users, streamlining the way you host, deploy, manage or update your websites like never before!</p>
        <div class="w-footer__ask" builder-data-element="flex" data-brx="block">
          <p class="w-footer__label" builder-data-element="text">Ask about <span class="w-footer__label-brand">PXpace</span> on</p>
          <ul class="w-footer__ask-list" builder-data-element="list">
            <li class="w-footer__ask-item" builder-data-element="text">
              <a class="w-footer__ask-link" builder-data-element="link" aria-label="ChatGPT" href="#">
                <img class="w-footer__ask-icon" builder-data-element="image" alt="" src="https://xcloud.host/_landing/agent/logos/openai.svg" />
              </a>
            </li>
            <li class="w-footer__ask-item" builder-data-element="text">
              <a class="w-footer__ask-link" builder-data-element="link" aria-label="Claude" href="#">
                <img class="w-footer__ask-icon" builder-data-element="image" alt="" src="https://xcloud.host/_landing/agent/logos/claude-ai.svg" />
              </a>
            </li>
            <li class="w-footer__ask-item" builder-data-element="text">
              <a class="w-footer__ask-link" builder-data-element="link" aria-label="Perplexity" href="#">
                <img class="w-footer__ask-icon" builder-data-element="image" alt="" src="https://xcloud.host/_landing/footer/perplexity.svg" />
              </a>
            </li>
            <li class="w-footer__ask-item" builder-data-element="text">
              <a class="w-footer__ask-link" builder-data-element="link" aria-label="Grok" href="#">
                <img class="w-footer__ask-icon" builder-data-element="image" alt="" src="https://xcloud.host/_landing/agent/logos/grok.svg" />
              </a>
            </li>
          </ul>
        </div>
      </div>
      <div class="w-footer__subscribe" builder-data-element="flex" data-brx="block">
        <p class="w-footer__label" builder-data-element="text">Get the latest updates</p>
        <FieldSubscribe label="Subscribe" />
      </div>
    </div>
    <div class="w-footer__menus" builder-data-element="div" data-brx="div">
      <div class="w-footer__menu-stack" builder-data-element="div" data-brx="div">
        <FooterMenuColumn title={"Products &amp; Services"} menu={"\n<li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Performance</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">One Click Apps</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Hosting Addons</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Cloudflare Enterprise</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">PXpace Managed Hosting</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">PXpace Self Managed Hosting</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">WordPress Hosting</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Laravel Hosting</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">OpenClaw Hosting</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Hermes Agent Hosting</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Reseller Hosting</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Agency Hosting</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Enterprise Hosting</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">n8n Hosting</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Node.js Hosting</a></li>\n"} more={"Load More<svg aria-hidden=\"true\" class=\"w-menu-column__more-icon\" viewbox=\"0 0 16 16\"><path d=\"M4 6l4 4 4-4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\"></path></svg>"} showMore={false} />
      </div>
      <div class="w-footer__menu-stack" builder-data-element="div" data-brx="div">
        <FooterMenuColumn title={"Resources"} menu={"\n<li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Roadmap</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Free Tools</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Knowledge Base</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Use Cases</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">AI Agents</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Video Tutorials</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Blog</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Free Vs PRO</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Community</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Write For Us</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Our Support</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Changelog</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Case Studies</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Showcase</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Brand Resources</a></li>\n"} more={"Load More<svg aria-hidden=\"true\" class=\"w-menu-column__more-icon\" viewbox=\"0 0 16 16\"><path d=\"M4 6l4 4 4-4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\"></path></svg>"} showMore={false} />
      </div>
      <div class="w-footer__menu-stack" builder-data-element="div" data-brx="div">
        <FooterMenuColumn title={"Compare <span class=\"w-menu-column__brand\">PXpace</span>"} menu={"\n<li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">PXpace vs Cloudways</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">PXpace vs ServerAvatar</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">PXpace vs SiteGround</a></li>\n"} more={"Load More<svg aria-hidden=\"true\" class=\"w-menu-column__more-icon\" viewbox=\"0 0 16 16\"><path d=\"M4 6l4 4 4-4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\"></path></svg>"} showMore />
        <FooterMenuColumn title={"Quick Help"} menu={"\n<li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Free Migration</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Free SSL</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Demo Site</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Staging Environment</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Privacy Policy</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Terms &amp; Conditions</a></li>\n"} more={"Load More<svg aria-hidden=\"true\" class=\"w-menu-column__more-icon\" viewbox=\"0 0 16 16\"><path d=\"M4 6l4 4 4-4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\"></path></svg>"} showMore={false} />
      </div>
      <div class="w-footer__menu-stack" builder-data-element="div" data-brx="div">
        <FooterMenuColumn title={"Addons"} menu={"\n<li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Cloudflare CDN</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">MailBox</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Site Security PRO</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Security</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Email Delivery</a></li>\n"} more={"Load More<svg aria-hidden=\"true\" class=\"w-menu-column__more-icon\" viewbox=\"0 0 16 16\"><path d=\"M4 6l4 4 4-4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\"></path></svg>"} showMore={false} />
        <FooterMenuColumn title={"Company"} menu={"\n<li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">About Us</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Careers</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Customer Reviews</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Schedule a Demo</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Affiliate Program</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Contact Us</a></li><li class=\"w-menu-column__item\"><a class=\"w-menu-column__link\" href=\"#\">Legal</a></li>\n"} more={"Load More<svg aria-hidden=\"true\" class=\"w-menu-column__more-icon\" viewbox=\"0 0 16 16\"><path d=\"M4 6l4 4 4-4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\"></path></svg>"} showMore={false} />
      </div>
    </div>
    <div class="w-footer__bottom" builder-data-element="div" data-brx="div">
      <div class="w-footer__address" builder-data-element="flex" data-brx="block">
        <img class="w-footer__address-dots" builder-data-element="image" alt="" src="https://xcloud.host/_landing/footer/dots.svg" />
        <p class="w-footer__address-label" builder-data-element="text">Address:</p>
        <p class="w-footer__address-text" builder-data-element="text">PXpace, 124 Broadkill Rd #599 Milton, DE 19968-1008</p>
      </div>
      <ul class="w-footer__social" builder-data-element="list">
        <li class="w-footer__social-item" builder-data-element="text">
          <SocialLink label="Facebook">
            <img class="w-social-link__icon" builder-data-element="image" alt="" src="https://xcloud.host/_landing/footer/facebook.svg" />
          </SocialLink>
        </li>
        <li class="w-footer__social-item" builder-data-element="text">
          <SocialLink label="Twitter">
            <img class="w-social-link__icon" builder-data-element="image" alt="" src="https://xcloud.host/_landing/footer/x.svg" />
          </SocialLink>
        </li>
        <li class="w-footer__social-item" builder-data-element="text">
          <SocialLink label="Linkedin">
            <img class="w-social-link__icon" builder-data-element="image" alt="" src="https://xcloud.host/_landing/footer/linkedin.svg" />
          </SocialLink>
        </li>
        <li class="w-footer__social-item" builder-data-element="text">
          <SocialLink label="YouTube">
            <img class="w-social-link__icon" builder-data-element="image" alt="" src="https://xcloud.host/_landing/footer/youtube.svg" />

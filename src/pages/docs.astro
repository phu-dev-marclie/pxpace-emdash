---
import Base from '../layouts/PlainBase.astro';
import DocsLayout from '../layouts/DocsLayout.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import DocsMenuButton from '../components/DocsMenuButton.astro';
import DocsQuickCard from '../components/DocsQuickCard.astro';
import DocsSearchBox from '../components/DocsSearchBox.astro';
import DocsTopic from '../components/DocsTopic.astro';
import DocsSearchDialog from '../components/DocsSearchDialog.astro';
import '../styles/generated/framework.css';
import '../styles/generated/global.css';
import '../styles/generated/pages/docs.css';
---
<Base title="Docs" siteName="PXpace" lang="en">
  <Fragment slot="head">
    <link rel="icon" href="/brand/favicon.png" type="image/png" />
    <meta property="og:locale" content="en" />
    <meta name="author" content="PXpace" />
    <script is:inline src="/scripts/snippets/snip-theme-mode-restore.js"></script>
  </Fragment>
  <DocsLayout>
    <section class="w-docs-hub" builder-data-element="section" data-surface="default" data-brx="section">
      <div class="w-docs-hub__container" builder-data-element="container" data-brx="container">
        <DocsSidebar metaLinkAriaCurrent="page" list={"\n<li class=\"w-docs-nav-group__item\"><a class=\"w-docs-nav-group__link\" href=\"#\">Introduction</a></li>\n<li class=\"w-docs-nav-group__item\"><a class=\"w-docs-nav-group__link\" href=\"/docs/quick-start\">First Server &amp; Site</a></li>\n<li class=\"w-docs-nav-group__item\"><a class=\"w-docs-nav-group__link\" href=\"#\">Create a Site</a></li>\n<li class=\"w-docs-nav-group__item\"><a class=\"w-docs-nav-group__link\" href=\"#\">Demo Site</a></li>\n<li class=\"w-docs-nav-group__item\"><a class=\"w-docs-nav-group__link\" href=\"#\">DNS Records</a></li>\n<li class=\"w-docs-nav-group__item\"><a class=\"w-docs-nav-group__link w-docs-nav-group__link--all\" href=\"#\">All 6 Quick Start docs</a></li>\n"} />
        <div class="w-docs-hub__main" builder-data-element="flex" data-brx="block">
          <header class="w-docs-hub__hero" builder-data-element="flex" data-brx="block">
            <div class="w-docs-hub__hero-row" builder-data-element="div" data-brx="div">
              <p class="w-eyebrow" builder-data-element="text">Documentation</p>
              <div class="w-docs-hub__tools" builder-data-element="div" data-brx="div">
                <ThemeToggle />
                <DocsMenuButton />
              </div>
            </div>
            <h1 class="w-heading-xl" builder-data-element="heading">
              Build, deploy and scale on{' '}
              <span class="w-highlight" builder-data-element="span">PXpace</span>
            </h1>
            <p class="w-text-l" builder-data-element="text">Everything you need to run sites, apps and servers — from your first deploy to production.</p>
          </header>
          <div class="w-docs-hub__quick" builder-data-element="div" data-brx="div">
            <DocsQuickCard link="/docs/quick-start" variant="w-docs-quick-card--amber" glyphViewBox="0 0 24 24" icon={"<path d=\"M13.5 3 5.5 13.2c-.3.4 0 .9.5.9H11l-.6 6.9c0 .5.6.7.9.3l8-10.2c.3-.4 0-.9-.5-.9H13.4l.6-6.9c0-.5-.6-.7-.9-.3Z\" fill=\"currentColor\"></path>"} title="Quick Start" text="Set up your first server and site in minutes." />
            <DocsQuickCard link="#" glyphViewBox="0 0 20 20" icon={"<g fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect height=\"5.25\" rx=\"1.25\" width=\"5.25\" x=\"3.5\" y=\"3.5\"></rect><rect height=\"5.25\" rx=\"1.25\" width=\"5.25\" x=\"11.25\" y=\"3.5\"></rect><rect height=\"5.25\" rx=\"1.25\" width=\"5.25\" x=\"3.5\" y=\"11.25\"></rect><rect height=\"5.25\" rx=\"1.25\" width=\"5.25\" x=\"11.25\" y=\"11.25\"></rect></g>"} title="One-Click Apps" text="Deploy 1,000+ apps and databases in one click." />
            <DocsQuickCard link="#" variant="w-docs-quick-card--violet" glyphViewBox="0 0 20 20" icon={"<path d=\"M3.25 10h9M9.25 6.5 12.75 10l-3.5 3.5M16 4v12\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\"></path>"} title="Migrate" text="Move your WordPress sites onto PXpace, free." />
            <DocsQuickCard link="#" variant="w-docs-quick-card--green" glyphViewBox="0 0 20 20" icon={"<path d=\"m7 6-4 4 4 4M13 6l4 4-4 4M11.25 4.5l-2.5 11\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\"></path>"} title="API & CLI" text="Automate PXpace with the documented public API." />
            <DocsQuickCard link="#" variant="w-docs-quick-card--wide" glyphViewBox="0 0 24 24" icon={"<path d=\"M12 1.5l2.4 6.6 6.6 2.4-6.6 2.4L12 19.5l-2.4-6.6L3 10.5l6.6-2.4L12 1.5z\" fill=\"currentColor\"></path><path d=\"M19 15.5l.9 2.6 2.6.9-2.6.9-.9 2.6-.9-2.6-2.6-.9 2.6-.9.9-2.6z\" fill=\"currentColor\"></path>"} title="PXpace MCP" text="Connect Claude, Cursor or any MCP client and manage hosting by asking." />
          </div>
          <div class="w-docs-hub__browse" builder-data-element="flex" data-brx="block">
            <header class="w-docs-hub__browse-head" builder-data-element="div" data-brx="div">
              <div class="w-docs-hub__browse-intro" builder-data-element="div" data-brx="div">
                <h2 class="w-heading-m" builder-data-element="heading">
                  Browse the{' '}
                  <span class="w-highlight" builder-data-element="span">docs</span>
                </h2>
                <p class="w-text-m" builder-data-element="text">Guides and references by topic.</p>
              </div>
              <div class="w-docs-hub__browse-search" builder-data-element="div" data-brx="div">
                <DocsSearchBox label="Search 180+ guides" />
              </div>
            </header>
            <div class="w-docs-hub__group" builder-data-element="flex" data-brx="block">
              <p class="w-docs-hub__group-label" builder-data-element="text"><span class="w-docs-hub__group-number">01</span>Get started</p>
              <div class="w-docs-hub__grid" builder-data-element="div" data-brx="div">
                <DocsTopic glyphViewBox="0 0 20 20" icon={"<g fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\"><path d=\"M8.5 13.5l-2-2C7.6 7.2 10.6 4.2 16.25 3.75 15.8 9.4 12.8 12.4 8.5 13.5Z\"></path><circle cx=\"12.25\" cy=\"7.75\" r=\"1.25\"></circle><path d=\"M6.5 11.5 4 11l2.25-3H9M8.5 13.5 9 16l3-2.25V11M5.25 14.75l-1.5 1.5\"></path></g>"} titleLinkLink="#" title="Quick Start" text="Create your first server and site." linkLink="/docs/quick-start" link="First Server & Site" link2="Create a Site" link3="Demo Site" link4="DNS Records">
                  <details class="w-docs-topic__more">
                    <summary class="w-docs-topic__more-toggle">
                      <span class="w-docs-topic__more-label" builder-data-element="span">Show 2 more</span>
                      <svg class="w-docs-topic__more-icon" builder-data-element="svg" aria-hidden="true" viewBox="0 0 16 16"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg>
                    </summary>
                    <ul class="w-docs-topic__list w-docs-topic__list--more" builder-data-element="list">
                      <li class="w-docs-topic__item" builder-data-element="text">
                        <a class="w-docs-topic__link" builder-data-element="link" href="#">WordPress Site Migration</a>
                      </li>
                      <li class="w-docs-topic__item" builder-data-element="text">
                        <a class="w-docs-topic__link" builder-data-element="link" href="#">Dashboard Navigation</a>
                      </li>
                    </ul>
                    <a class="w-docs-topic__all" builder-data-element="link" href="#">
                      <span class="w-docs-topic__all-label" builder-data-element="span">All 6 Quick Start docs</span>
                      <svg class="w-docs-topic__all-icon" builder-data-element="svg" aria-hidden="true" viewBox="0 0 14 14"><path d="M5 3l4 4-4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"></path></svg>
                    </a>
                  </details>
                </DocsTopic>
                <DocsTopic glyphViewBox="0 0 20 20" icon={"<g fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6.75\"></circle><path d=\"M3.25 10h13.5M10 3.25c1.9 1.85 2.75 4.1 2.75 6.75S11.9 14.9 10 16.75C8.1 14.9 7.25 12.65 7.25 10S8.1 5.1 10 3.25Z\"></path></g>"} titleLinkLink="#" title="Sites" text="Domains, staging, cloning and site management." linkLink="#" link="Blueprints" link2="Staging Environment" link3="Go Live from Staging" link4="Clone to Another Server">
                  <details class="w-docs-topic__more">
                    <summary class="w-docs-topic__more-toggle">
                      <span class="w-docs-topic__more-label" builder-data-element="span">Show 20 more</span>
                      <svg class="w-docs-topic__more-icon" builder-data-element="svg" aria-hidden="true" viewBox="0 0 16 16"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg>
                    </summary>
                    <ul class="w-docs-topic__list w-docs-topic__list--more" builder-data-element="list">
                      <li class="w-docs-topic__item" builder-data-element="text">
                        <a class="w-docs-topic__link" builder-data-element="link" href="#">HTTPS &amp; SSL Certificates</a>
                      </li>
                      <li class="w-docs-topic__item" builder-data-element="text">
                        <a class="w-docs-topic__link" builder-data-element="link" href="#">SFTP Access</a>
                      </li>
                    </ul>
                    <a class="w-docs-topic__all" builder-data-element="link" href="#">
                      <span class="w-docs-topic__all-label" builder-data-element="span">All 24 Sites docs</span>
                      <svg class="w-docs-topic__all-icon" builder-data-element="svg" aria-hidden="true" viewBox="0 0 14 14"><path d="M5 3l4 4-4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"></path></svg>
                    </a>
                  </details>
                </DocsTopic>
                <DocsTopic glyphViewBox="0 0 20 20" icon={"<g fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect height=\"5\" rx=\"1.5\" width=\"13.5\" x=\"3.25\" y=\"3.75\"></rect><rect height=\"5\" rx=\"1.5\" width=\"13.5\" x=\"3.25\" y=\"11.25\"></rect></g><circle cx=\"6.25\" cy=\"6.25\" fill=\"currentColor\" r=\".9\"></circle><circle cx=\"6.25\" cy=\"13.75\" fill=\"currentColor\" r=\".9\"></circle>"} titleLinkLink="#" title="Servers" text="Provision servers and manage PHP, cron and services." linkLink="#" link="Server Locations" link2="Available Server Stacks" link3="Connect Any Provider" link4="Cron Jobs">
                  <details class="w-docs-topic__more">
                    <summary class="w-docs-topic__more-toggle">
                      <span class="w-docs-topic__more-label" builder-data-element="span">Show 27 more</span>
                      <svg class="w-docs-topic__more-icon" builder-data-element="svg" aria-hidden="true" viewBox="0 0 16 16"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg>
                    </summary>
                    <ul class="w-docs-topic__list w-docs-topic__list--more" builder-data-element="list">
                      <li class="w-docs-topic__item" builder-data-element="text">
                        <a class="w-docs-topic__link" builder-data-element="link" href="#">Web Terminal</a>
                      </li>
                      <li class="w-docs-topic__item" builder-data-element="text">
                        <a class="w-docs-topic__link" builder-data-element="link" href="#">PHP Extensions</a>
                      </li>
                    </ul>
                    <a class="w-docs-topic__all" builder-data-element="link" href="#">

                <DocsTopic glyphViewBox="0 0 20 20" icon={"<path d=\"M3.5 14a6.5 6.5 0 1 1 13 0M10 14l3-4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\"></path>"} titleLinkLink="#" title="Cache" text="Page cache, Redis object cache and OPcache." linkLink="#" link="How Caching Works" link2="Full Page Cache" link3="Redis Object Cache" link4="Query String Caching">

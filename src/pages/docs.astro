                <DocsTopic glyphViewBox="0 0 20 20" icon={"<g fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect height=\"5.25\" rx=\"1.25\" width=\"5.25\" x=\"3.5\" y=\"3.5\"></rect><rect height=\"5.25\" rx=\"1.25\" width=\"5.25\" x=\"11.25\" y=\"3.5\"></rect><rect height=\"5.25\" rx=\"1.25\" width=\"5.25\" x=\"3.5\" y=\"11.25\"></rect><rect height=\"5.25\" rx=\"1.25\" width=\"5.25\" x=\"11.25\" y=\"11.25\"></rect></g>"} titleLinkLink="#" title="One-Click Apps" text="Deploy 1,000+ apps, databases and Git projects." linkLink="#" link="App Templates" link2="Multi-Domain Apps" link3="Domains & Ports" link4="Updates & Compose">
                  <details class="w-docs-topic__more">

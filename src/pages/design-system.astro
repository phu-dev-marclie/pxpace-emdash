---
import Base from '../layouts/PlainBase.astro';
import DesignSystemLayout from '../layouts/DesignSystemLayout.astro';
import ButtonArrow from '../components/ButtonArrow.astro';
import ButtonTrack from '../components/ButtonTrack.astro';
import ButtonMarquee from '../components/ButtonMarquee.astro';
import ButtonRipple from '../components/ButtonRipple.astro';
import ButtonDot from '../components/ButtonDot.astro';
import ButtonNudge from '../components/ButtonNudge.astro';
import ButtonGlow from '../components/ButtonGlow.astro';
import FieldText from '../components/FieldText.astro';
import FieldSelect from '../components/FieldSelect.astro';
import FieldPassword from '../components/FieldPassword.astro';
import FieldDate from '../components/FieldDate.astro';
import FieldChoice from '../components/FieldChoice.astro';
import FieldTextarea from '../components/FieldTextarea.astro';
import '../styles/generated/framework.css';
import '../styles/generated/global.css';
import '../styles/generated/pages/design-system.css';
---
<Base title="Design System" noindex siteName="PXpace" lang="en">
  <Fragment slot="head">
    <link rel="icon" href="/brand/favicon.png" type="image/png" />
    <meta property="og:locale" content="en" />
    <meta name="author" content="PXpace" />
    <script is:inline src="/scripts/snippets/snip-theme-mode-restore.js"></script>
  </Fragment>
  <DesignSystemLayout>
    <section class="w-ds-intro" builder-data-element="section" data-surface="default" data-brx="section">
      <div class="w-ds-intro__container" builder-data-element="container" data-brx="container">
        <a class="w-badge-rating" builder-data-element="link" href="#colors">
          <svg class="w-badge-rating__icon" builder-data-element="svg" aria-hidden="true" viewBox="0 0 12 12"><path d="M6 1l1.545 3.13 3.455.502-2.5 2.436.59 3.432L6 8.887 2.91 10.5l.59-3.432L1 4.632l3.455-.502L6 1z" fill="currentColor"></path></svg>
          <span class="w-badge-rating__text" builder-data-element="span">PXpace brand · Bricks-ready (w- BEM · Core Framework tokens)</span>
        </a>
        <h1 class="w-heading-2xl" builder-data-element="heading">The <span class="w-highlight">PXpace</span> Design System</h1>
        <p class="w-text-m" builder-data-element="text">Every value on this page is a token from <code class="w-ds-code">assets/tokens.css</code> (generated by <code class="w-ds-code">tokens.py</code>, identical to Bricks' Style Manager output) and every widget is a global class from <code class="w-ds-code">assets/components.css</code>.</p>
        <div class="w-ds-intro__actions" builder-data-element="flex" data-brx="block">
          <a class="w-button-primary" builder-data-element="link" href="#components">
            <span class="w-button-primary__labels" builder-data-element="span" data-split-chars="w-button-primary__char">
              <span class="w-button-primary__label" builder-data-element="span">Browse components</span>
              <span class="w-button-primary__label-next" builder-data-element="span" aria-hidden="true">Browse components</span>
            </span>
            <svg class="w-button-primary__icon" builder-data-element="svg" aria-hidden="true" viewBox="0 0 18 18"><path class="w-button-primary__icon-stem" d="M4.5 9h9.5"></path><path class="w-button-primary__icon-head" d="M6.75 4.5 11.25 9l-4.5 4.5"></path></svg>
          </a>
          <a class="w-button-outline" builder-data-element="link" href="/">
            <span class="w-button-outline__labels" builder-data-element="span">
              <span class="w-button-outline__label" builder-data-element="span">See the homepage replica</span>
              <span class="w-button-outline__label-next" builder-data-element="span" aria-hidden="true">See the homepage replica</span>
            </span>
          </a>
        </div>
      </div>
    </section>
    <section class="w-ds-colors" builder-data-element="section" data-surface="default" id="colors" data-brx="section">
      <div class="w-ds-colors__container" builder-data-element="container" data-brx="container">
        <header class="w-ds-head" builder-data-element="header">
          <p class="w-ds-head__number" builder-data-element="text">01 — COLOR · Style Manager › Colors (light + dark)</p>
          <h2 class="w-heading-xl" builder-data-element="heading">
            Cool neutrals,{' '}
            <span class="w-highlight" builder-data-element="span">one blue</span>
          </h2>
          <p class="w-text-m" builder-data-element="text">Brand colours carry Bricks-generated shades (<code class="w-ds-code">-l-1…4</code> / <code class="w-ds-code">-d-1…4</code>). Components never read a hex: they read Theme roles (<code class="w-ds-code">--bg-*</code>, <code class="w-ds-code">--text-*</code>, <code class="w-ds-code">--border-*</code>). Every role has a light and a dark value — use the switch in the header; values below update live. Dark bands re-point roles with <code class="w-ds-code">data-surface</code>.</p>
        </header>
        <div class="w-ds-group" builder-data-element="div">
          <h3 class="w-ds-subhead" builder-data-element="heading">Brand · PXpace · Brand</h3>
          <div class="w-ds-swatches" builder-data-element="div" data-ds-swatches="primary primary-l-1 primary-l-2 primary-l-3 primary-l-4 primary-d-1 primary-d-2 primary-d-3 primary-d-4 secondary secondary-l-2 secondary-l-4 tertiary"></div>
        </div>
        <div class="w-ds-group" builder-data-element="div">
          <h3 class="w-ds-subhead" builder-data-element="heading">Backgrounds · Theme roles</h3>
          <div class="w-ds-swatches" builder-data-element="div" data-ds-swatches="bg-body bg-surface bg-surface-2 bg-surface-3 bg-surface-4 bg-band bg-header bg-accent bg-accent-2 bg-base bg-base-2 bg-base-3 bg-night bg-night-2 bg-night-3 bg-deep bg-sky"></div>
        </div>
        <div class="w-ds-group" builder-data-element="div">
          <h3 class="w-ds-subhead" builder-data-element="heading">Text · one colour per role</h3>
          <div class="w-ds-swatches" builder-data-element="div" data-ds-swatches="text-title text-body text-body-dark text-disabled text-eyebrow text-overline text-highlight text-dim text-badge text-chip text-contrast text-contrast-body text-contrast-muted text-contrast-highlight accent"></div>
        </div>
        <div class="w-ds-group" builder-data-element="div">
          <h3 class="w-ds-subhead" builder-data-element="heading">Borders, icons, interaction, status</h3>
          <div class="w-ds-swatches" builder-data-element="div" data-ds-swatches="border-subtle border-light border-dark border-soft border-base border-night icon icon-muted icon-contrast active active-hover focus success success-bg warning warning-bg error error-bg"></div>
        </div>
        <div class="w-ds-group" builder-data-element="div">
          <h3 class="w-ds-subhead" builder-data-element="heading">Component colours · PXpace · Components</h3>
          <div class="w-ds-swatches" builder-data-element="div" data-ds-swatches="btn-secondary-bg btn-secondary-ring btn-outline-bg btn-outline-fg btn-outline-ring badge-rating-fg badge-pill-fg toggle-track toggle-knob hero-word-active plan-title-fg tile-integration-bg"></div>
        </div>
        <div class="w-ds-group" builder-data-element="div">
          <h3 class="w-ds-subhead" builder-data-element="heading">Neutrals (Core Framework ramps)</h3>
          <div class="w-ds-swatches" builder-data-element="div" data-ds-swatches="light dark-5 dark-10 dark-20 dark-50 dark all-light all-dark"></div>
        </div>
      </div>
    </section>
    <section class="w-ds-type" builder-data-element="section" data-surface="default" id="type" data-brx="section">
      <div class="w-ds-type__container" builder-data-element="container" data-brx="container">
        <header class="w-ds-head" builder-data-element="header">
          <p class="w-ds-head__number" builder-data-element="text">02 — TYPOGRAPHY · Style Manager › Typography scale (text-)</p>
          <h2 class="w-heading-xl" builder-data-element="heading">
            Funnel Display headings,{' '}
            <span class="w-highlight" builder-data-element="span">serif accents</span>
          </h2>
          <p class="w-text-m" builder-data-element="text">Headings use <code class="w-ds-code">--font-family-display</code> (Funnel Display), body <code class="w-ds-code">--font-family</code> (Inter Tight), accents <code class="w-ds-code">--font-family-serif</code> (Instrument Serif). Sizes come from the <code class="w-ds-code">--text-xs…7xl</code> scale (fluid 320 → 1440 px), line heights from the unitless <code class="w-ds-code">--line-height-*</code> ramp.</p>
        </header>
        <div class="w-ds-table" builder-data-element="div">
          <div class="w-ds-table__row" builder-data-element="div">
            <p class="w-ds-table__meta" builder-data-element="text">.w-heading-2xl<br>--text-7xl 34→60 · lh xs 1.05 · −1.2px</p>
            <div class="w-ds-table__sample" builder-data-element="div">
              <p class="w-heading-2xl" builder-data-element="text">Host Anything.</p>
            </div>
            <p class="w-ds-table__meta" builder-data-element="text">home hero H1</p>
          </div>
          <div class="w-ds-table__row" builder-data-element="div">
            <p class="w-ds-table__meta" builder-data-element="text">.w-heading-xl<br>--text-4xl 28→40 · lh s 1.1 · −1px</p>
            <div class="w-ds-table__sample" builder-data-element="div">
              <p class="w-heading-xl" builder-data-element="text">A <span class="w-highlight">Modern</span> Control Panel</p>
            </div>
            <p class="w-ds-table__meta" builder-data-element="text">centered section H2</p>
          </div>
          <div class="w-ds-table__row" builder-data-element="div">
            <p class="w-ds-table__meta" builder-data-element="text">.w-heading-l<br>--text-3xl 26→36 · lh m 1.2 · −1px</p>
            <div class="w-ds-table__sample" builder-data-element="div">
              <p class="w-heading-l" builder-data-element="text">Security That Doesn't Wait</p>
            </div>
            <p class="w-ds-table__meta" builder-data-element="text">split-header / dark-band H2, CTA</p>
          </div>
          <div class="w-ds-table__row" builder-data-element="div">
            <p class="w-ds-table__meta" builder-data-element="text">.w-heading-m<br>--text-2xl 24→32 · lh m 1.2 · −0.96px</p>
            <div class="w-ds-table__sample" builder-data-element="div">
              <p class="w-heading-m" builder-data-element="text">
                Works With the{' '}
                <span class="w-highlight" builder-data-element="span">Agents You Use</span>
              </p>
            </div>
            <p class="w-ds-table__meta" builder-data-element="text">sub-section H3</p>
          </div>
          <div class="w-ds-table__row" builder-data-element="div">
            <p class="w-ds-table__meta" builder-data-element="text">.w-heading-s<br>--text-xl 20→24 · lh xl 1.4 · −0.24px</p>
            <div class="w-ds-table__sample" builder-data-element="div">
              <p class="w-heading-s" builder-data-element="text">Self-Managed Hosting</p>
            </div>
            <p class="w-ds-table__meta" builder-data-element="text">card / plan titles</p>
          </div>
          <div class="w-ds-table__row" builder-data-element="div">
            <p class="w-ds-table__meta" builder-data-element="text">.w-heading-xs<br>--text-l 16→18 · 500 · lh l 1.3</p>
            <div class="w-ds-table__sample" builder-data-element="div">
              <p class="w-heading-xs" builder-data-element="text">Fast, Safe WordPress and WooCommerce</p>
            </div>
            <p class="w-ds-table__meta" builder-data-element="text">small titles</p>
          </div>
          <div class="w-ds-table__row" builder-data-element="div">
            <p class="w-ds-table__meta" builder-data-element="text">.w-text-l<br>--text-m 16 · lh 3xl 1.6</p>
            <div class="w-ds-table__sample" builder-data-element="div">
              <p class="w-text-l" builder-data-element="text">Paste a repository URL and PXpace works out the rest: your stack, your branch, the deploy script.</p>
            </div>
            <p class="w-ds-table__meta" builder-data-element="text">lede, body large</p>
          </div>
          <div class="w-ds-table__row" builder-data-element="div">
            <p class="w-ds-table__meta" builder-data-element="text">.w-text-m<br>--text-s 14 · lh 2xl 1.5</p>
            <div class="w-ds-table__sample" builder-data-element="div">
              <p class="w-text-m" builder-data-element="text">Manage servers, applications, databases, teams, backups, deployments, and security from one intuitive dashboard.</p>
            </div>
            <p class="w-ds-table__meta" builder-data-element="text">default sub-copy</p>
          </div>
          <div class="w-ds-table__row" builder-data-element="div">
            <p class="w-ds-table__meta" builder-data-element="text">.w-text-s<br>--text-xs 12 · lh xl 1.4</p>
            <div class="w-ds-table__sample" builder-data-element="div">
              <p class="w-text-s" builder-data-element="text">Kernel TCP protection, before Ubuntu's official fix</p>
            </div>
            <p class="w-ds-table__meta" builder-data-element="text">meta, captions</p>
          </div>
          <div class="w-ds-table__row" builder-data-element="div">
            <p class="w-ds-table__meta" builder-data-element="text">.w-eyebrow<br>12 · 500 · upper · +0.4px</p>
            <div class="w-ds-table__sample" builder-data-element="div">
              <p class="w-eyebrow" builder-data-element="text">WordPress hosting</p>
            </div>
            <p class="w-ds-table__meta" builder-data-element="text">--text-eyebrow</p>
          </div>
          <div class="w-ds-table__row" builder-data-element="div">
            <p class="w-ds-table__meta" builder-data-element="text">.w-overline<br>14 · sentence case</p>
            <div class="w-ds-table__sample" builder-data-element="div">
              <p class="w-overline" builder-data-element="text">Deploy from Git</p>
            </div>
            <p class="w-ds-table__meta" builder-data-element="text">--text-overline</p>
          </div>
          <div class="w-ds-table__row" builder-data-element="div">
            <p class="w-ds-table__meta" builder-data-element="text">.w-highlight / .w-dim / .w-mark<br>inline (rich text) · serif italic at 1.15em</p>
            <div class="w-ds-table__sample" builder-data-element="div">
              <p class="w-heading-m" builder-data-element="text"><span class="w-highlight">Serif accent</span> · <span class="w-dim">dimmed half</span></p>
              <p class="w-text-m" builder-data-element="text">Connect with <span class="w-mark">MCP</span> clients.</p>
            </div>
            <p class="w-ds-table__meta" builder-data-element="text">--font-family-serif · --font-size-serif · --text-highlight · --text-dim</p>
          </div>
        </div>
      </div>
    </section>
    <section class="w-ds-fonts" builder-data-element="section" data-surface="default" id="fonts" data-brx="section">
      <div class="w-ds-fonts__container" builder-data-element="container" data-brx="container">
        <header class="w-ds-head" builder-data-element="header">
          <p class="w-ds-head__number" builder-data-element="text">02b — FONTS · Bricks › Custom fonts (self-hosted woff2)</p>
          <h2 class="w-heading-xl" builder-data-element="heading">
            Five languages,{' '}
            <span class="w-highlight" builder-data-element="span">one voice</span>
          </h2>
          <p class="w-text-m" builder-data-element="text">Every file in <code class="w-ds-code">fonts/</code> is a static weight subset to English, French, German, Croatian and Vietnamese. Funnel Display and Instrument Serif ship without Vietnamese upstream; <code class="w-ds-code">fonts/build_fonts.py</code> adds dấu hỏi, dấu nặng and the móc of ơ/ư and composes the 96 missing Vietnamese letters plus ₫ (all 134 letters now present).</p>
        </header>
        <div class="w-ds-table" builder-data-element="div">
          <div class="w-ds-table__row" builder-data-element="div">
            <p class="w-ds-table__meta" builder-data-element="text">Funnel Display 400 · 500 · 600<br>--font-family-display</p>
            <div class="w-ds-table__sample" builder-data-element="div">
              <p class="w-heading-l" builder-data-element="text">Lưu trữ mọi thứ. Mở rộng không giới hạn.</p>
              <p class="w-heading-s" builder-data-element="text">Quản lý dễ dàng hơn — Ấn tượng, Ổn định, Ữ Ự Ở Ợ</p>
            </div>
            <p class="w-ds-table__meta" builder-data-element="text">VI · completed by build_fonts.py</p>
          </div>
          <div class="w-ds-table__row" builder-data-element="div">
            <p class="w-ds-table__meta" builder-data-element="text">Funnel Display<br>HR · FR · DE · EN</p>
            <div class="w-ds-table__sample" builder-data-element="div">
              <p class="w-heading-s" builder-data-element="text">Čćđšž Ćevapčići · Œuvre déjà Noël · Größe Übermäßig ẞ „Zitat“ · Host anything</p>
            </div>
            <p class="w-ds-table__meta" builder-data-element="text">upstream glyphs</p>
          </div>
          <div class="w-ds-table__row" builder-data-element="div">
            <p class="w-ds-table__meta" builder-data-element="text">Inter Tight 400 · 500 · 600<br>--font-family</p>
            <div class="w-ds-table__sample" builder-data-element="div">
              <p class="w-text-l" builder-data-element="text">Triển khai WordPress, Laravel, Node.js chỉ trong vài phút. Hrvatski: Želim čašu vode. Français : à l'œil nu. Deutsch: Straße, Bücher.</p>
            </div>
            <p class="w-ds-table__meta" builder-data-element="text">upstream glyphs</p>
          </div>
          <div class="w-ds-table__row" builder-data-element="div">
            <p class="w-ds-table__meta" builder-data-element="text">Instrument Serif Italic 400<br>--font-family-serif · italic only</p>
            <div class="w-ds-table__sample" builder-data-element="div">
              <p class="w-heading-l" builder-data-element="text">
                <span class="w-highlight" builder-data-element="span">Người dùng tin tưởng · Đặc biệt · Ưu đãi · Ợ Ậ Ặ ụ ị</span>
              </p>
            </div>
            <p class="w-ds-table__meta" builder-data-element="text">VI · completed by build_fonts.py</p>
          </div>
          <div class="w-ds-table__row" builder-data-element="div">
            <p class="w-ds-table__meta" builder-data-element="text">Geist Mono 400 · 500<br>--font-family-mono</p>
            <div class="w-ds-table__sample" builder-data-element="div">
              <p class="w-ds-code" builder-data-element="text">162.368 trang · Đà Nẵng · 120.000 ₫ · Žuta kuća · Größe · €49</p>
            </div>
            <p class="w-ds-table__meta" builder-data-element="text">₫ added by build_fonts.py</p>
          </div>
        </div>
      </div>
    </section>
    <section class="w-ds-spacing" builder-data-element="section" data-surface="default" id="spacing" data-brx="section">
      <div class="w-ds-spacing__container" builder-data-element="container" data-brx="container">
        <header class="w-ds-head" builder-data-element="header">
          <p class="w-ds-head__number" builder-data-element="text">03 — SPACING &amp; LAYOUT · Style Manager › Spacing scale (space-)</p>
          <h2 class="w-heading-xl" builder-data-element="heading">Fluid spacing, <span class="w-highlight">blueprint</span> frame</h2>
          <p class="w-text-m" builder-data-element="text">Steps up to <code class="w-ds-code">--space-s</code> are fixed (4–16 px); from <code class="w-ds-code">--space-m</code> they are clamps over 320 → 1440 px and reach their full values at 1440. Container = <code class="w-ds-code">--max-screen-width</code> 1440 px; framed sections cap their container at <code class="w-ds-code">--layout-frame</code> 1200 px, the rails sit on that frame and the 20 px gutter is the section's <code class="w-ds-code">--layout-margin</code>.</p>
        </header>
        <div class="w-ds-scale" builder-data-element="div" data-ds-scale="space-3xs space-2xs space-xs space-s space-m space-l space-xl space-2xl space-3xl space-4xl space-5xl"></div>
        <div class="w-ds-table" builder-data-element="div">
          <div class="w-ds-table__row" builder-data-element="div">
            <p class="w-ds-table__meta" builder-data-element="text">--layout-inset 32px</p>
            <p class="w-text-m" builder-data-element="text">cards inset from the rails (hosting grid)</p>
            <p class="w-ds-table__meta" builder-data-element="text">Variables › Layout</p>
          </div>
          <div class="w-ds-table__row" builder-data-element="div">
            <p class="w-ds-table__meta" builder-data-element="text">--columns-2 / -3 / -4</p>
            <p class="w-text-m" builder-data-element="text">equal grid tracks; unequal: minmax(0, 9fr) minmax(0, 11fr)</p>
            <p class="w-ds-table__meta" builder-data-element="text">grid on the parent</p>
          </div>
          <div class="w-ds-table__row" builder-data-element="div">
            <p class="w-ds-table__meta" builder-data-element="text">Breakpoints</p>
            <p class="w-text-m" builder-data-element="text">desktop · laptop 1279 (custom) · tablet 991 · mobile landscape 767 · mobile portrait 478</p>
            <p class="w-ds-table__meta" builder-data-element="text">max-width only</p>
          </div>
        </div>
      </div>
    </section>
    <section class="w-ds-shape" builder-data-element="section" data-surface="default" id="shape" data-brx="section">
      <div class="w-ds-shape__container" builder-data-element="container" data-brx="container">
        <header class="w-ds-head" builder-data-element="header">
          <p class="w-ds-head__number" builder-data-element="text">04 — RADIUS · STROKES · SHADOWS · Variables</p>
          <h2 class="w-heading-xl" builder-data-element="heading">
            Square cells,{' '}
            <span class="w-highlight" builder-data-element="span">soft cards</span>
          </h2>
          <p class="w-text-m" builder-data-element="text">Hairline grids are 1 px gaps over <code class="w-ds-code">--border-subtle</code> (0 radius). Free cards use <code class="w-ds-code">--radius-l</code> 16 px, buttons <code class="w-ds-code">--radius-s</code> 8 px. Resting cards have no shadow.</p>
        </header>
        <div class="w-ds-group" builder-data-element="div">
          <h3 class="w-ds-subhead" builder-data-element="heading">Radius</h3>
          <div class="w-ds-tiles" builder-data-element="div" data-ds-radius="radius-xs radius-s radius-m radius-l radius-xl radius-2xl radius-3xl radius-full"></div>
        </div>
        <div class="w-ds-group" builder-data-element="div">
          <h3 class="w-ds-subhead" builder-data-element="heading">Shadows (incl. component variables)</h3>
          <div class="w-ds-tiles" builder-data-element="div" data-ds-shadow="shadow-xs shadow-s shadow-m shadow-l shadow-xl shadow-glass shadow-popover btn-primary-shadow btn-secondary-shadow btn-outline-shadow card-testimonial-shadow-hover input-ring-focus input-ring-error"></div>
        </div>
        <div class="w-ds-group" builder-data-element="div">
          <h3 class="w-ds-subhead" builder-data-element="heading">Strokes</h3>
          <div class="w-ds-tiles" builder-data-element="div" data-ds-stroke="stroke-subtle stroke stroke-strong"></div>
        </div>
      </div>
    </section>
    <section class="w-ds-motion" builder-data-element="section" data-surface="default" id="motion" data-brx="section">
      <div class="w-ds-motion__container" builder-data-element="container" data-brx="container">
        <header class="w-ds-head" builder-data-element="header">

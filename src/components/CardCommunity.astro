---
import ButtonDot from './ButtonDot.astro';
import SiterealRichText from './sitereal/RichText.astro';
interface Props {
  eyebrowIcon?: string;
  eyebrow?: string;
  statement?: string;
  label?: string;
  image?: string;
}
const { eyebrowIcon = "<rect fill=\"none\" height=\"15\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"1.25\" width=\"12\" x=\"4\" y=\"2.5\"></rect><path d=\"M7 7h6M7 10h6M7 13h4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.25\"></path>", eyebrow = "Publication", statement = "<span class=\"w-dim\">PXpace Featured Across</span> Industry-Leading Publications", label = "Explore More", image = "https://xcloud.host/_landing/community/press-collage.png" } = Astro.props;
---
<div class="w-card-community" builder-data-element="div">
  <div class="w-card-community__top" builder-data-element="div">
    <div class="w-card-community__head" builder-data-element="div">
      <p class="w-card-community__eyebrow" builder-data-element="text">
        <svg class="w-card-community__eyebrow-icon" builder-data-element="rich-text" aria-hidden="true" viewBox="0 0 20 20"><SiterealRichText html={eyebrowIcon} /></svg>
        <span class="w-card-community__eyebrow-label" builder-data-element="span">{eyebrow}</span>
      </p>
      <h3 class="w-card-community__statement" builder-data-element="rich-text"><SiterealRichText html={statement} /></h3>
    </div>
    <ButtonDot link="#" label={label} />
  </div>
  <div class="w-card-community__media" builder-data-element="div">
    <img class="w-card-community__image" builder-data-element="image" alt="" src={image} />
  </div>
</div>

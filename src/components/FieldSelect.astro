---
import SiterealRichText from './sitereal/RichText.astro';
interface Props {
  labelFor?: string;
  labelId?: string;
  label?: string;
  required?: string;
  inputName?: string;
  inputValue?: string;
  triggerAriaControls?: string;
  triggerAriaDescribedby?: string;
  triggerAriaLabelledby?: string;
  triggerId?: string;
  valueId?: string;
  valueVariant?: string;
  value?: string;
  showSearch?: boolean;
  listAriaLabelledby?: string;
  listAriaRequired?: string;
  listId?: string;
  list?: string;
  empty?: string;
  hintId?: string;
  hint?: string;
  error?: string;
  showError?: boolean;
}
const { labelFor = "f-region", labelId = "f-region-label", label = "Server region", required = "", inputName = "region", inputValue = "", triggerAriaControls = "f-region-list", triggerAriaDescribedby = "", triggerAriaLabelledby = "f-region-label f-region-value", triggerId = "f-region", valueId = "f-region-value", valueVariant = "", value = "Choose a region", showSearch = true, listAriaLabelledby = "f-region-label", listAriaRequired = "", listId = "f-region-list", list = "\n<li aria-selected=\"false\" class=\"w-select__option\" data-select-option=\"\" data-value=\"sgp1\" id=\"f-region-sgp1\" role=\"option\"><span aria-hidden=\"true\" class=\"w-select__option-dot\"></span><span class=\"w-select__option-label\" data-select-label=\"\">Singapore</span><span class=\"w-select__option-meta\">sgp1 · 38 ms</span><svg aria-hidden=\"true\" class=\"w-select__option-check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg></li>\n<li aria-selected=\"false\" class=\"w-select__option\" data-select-option=\"\" data-value=\"blr1\" id=\"f-region-blr1\" role=\"option\"><span aria-hidden=\"true\" class=\"w-select__option-dot\"></span><span class=\"w-select__option-label\" data-select-label=\"\">Bangalore</span><span class=\"w-select__option-meta\">blr1 · 74 ms</span><svg aria-hidden=\"true\" class=\"w-select__option-check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg></li>\n<li aria-selected=\"false\" class=\"w-select__option\" data-select-option=\"\" data-value=\"syd1\" id=\"f-region-syd1\" role=\"option\"><span aria-hidden=\"true\" class=\"w-select__option-dot\"></span><span class=\"w-select__option-label\" data-select-label=\"\">Sydney</span><span class=\"w-select__option-meta\">syd1 · 96 ms</span><svg aria-hidden=\"true\" class=\"w-select__option-check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg></li>\n<li aria-selected=\"false\" class=\"w-select__option\" data-select-option=\"\" data-value=\"ams3\" id=\"f-region-ams3\" role=\"option\"><span aria-hidden=\"true\" class=\"w-select__option-dot w-select__option-dot--mid\"></span><span class=\"w-select__option-label\" data-select-label=\"\">Amsterdam</span><span class=\"w-select__option-meta\">ams3 · 158 ms</span><svg aria-hidden=\"true\" class=\"w-select__option-check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg></li>\n<li aria-selected=\"false\" class=\"w-select__option\" data-select-option=\"\" data-value=\"fra1\" id=\"f-region-fra1\" role=\"option\"><span aria-hidden=\"true\" class=\"w-select__option-dot w-select__option-dot--mid\"></span><span class=\"w-select__option-label\" data-select-label=\"\">Frankfurt</span><span class=\"w-select__option-meta\">fra1 · 162 ms</span><svg aria-hidden=\"true\" class=\"w-select__option-check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg></li>\n<li aria-selected=\"false\" class=\"w-select__option\" data-select-option=\"\" data-value=\"lon1\" id=\"f-region-lon1\" role=\"option\"><span aria-hidden=\"true\" class=\"w-select__option-dot w-select__option-dot--mid\"></span><span class=\"w-select__option-label\" data-select-label=\"\">London</span><span class=\"w-select__option-meta\">lon1 · 171 ms</span><svg aria-hidden=\"true\" class=\"w-select__option-check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg></li>\n<li aria-selected=\"false\" class=\"w-select__option\" data-select-option=\"\" data-value=\"sfo3\" id=\"f-region-sfo3\" role=\"option\"><span aria-hidden=\"true\" class=\"w-select__option-dot w-select__option-dot--mid\"></span><span class=\"w-select__option-label\" data-select-label=\"\">San Francisco</span><span class=\"w-select__option-meta\">sfo3 · 189 ms</span><svg aria-hidden=\"true\" class=\"w-select__option-check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg></li>\n<li aria-selected=\"false\" class=\"w-select__option\" data-select-option=\"\" data-value=\"nyc3\" id=\"f-region-nyc3\" role=\"option\"><span aria-hidden=\"true\" class=\"w-select__option-dot w-select__option-dot--far\"></span><span class=\"w-select__option-label\" data-select-label=\"\">New York</span><span class=\"w-select__option-meta\">nyc3 · 228 ms</span><svg aria-hidden=\"true\" class=\"w-select__option-check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg></li>\n<li aria-selected=\"false\" class=\"w-select__option\" data-select-option=\"\" data-value=\"tor1\" id=\"f-region-tor1\" role=\"option\"><span aria-hidden=\"true\" class=\"w-select__option-dot w-select__option-dot--far\"></span><span class=\"w-select__option-label\" data-select-label=\"\">Toronto</span><span class=\"w-select__option-meta\">tor1 · 241 ms</span><svg aria-hidden=\"true\" class=\"w-select__option-check\" viewbox=\"0 0 16 16\"><path d=\"M3.33 8l3.33 3.33 6.67-6.66\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.33\"></path></svg></li>\n", empty = "No region matches.", hintId = "", hint = "Latency measured from you. Type to filter.", error = "", showError = true } = Astro.props;
---
<div class="w-form-field" builder-data-element="div" data-field="">
  <label class="w-form-field__label" builder-data-element="form-label" for={labelFor} id={labelId}>
    <span class="w-form-field__label-text" builder-data-element="span">{label}</span>
    <span class="w-form-field__required" builder-data-element="span" aria-hidden="true">*</span>
  </label>
  <div class="w-select" builder-data-element="div" data-field-control="" data-required={required} data-select="">
    <input class="w-select__input" builder-data-element="form-input" data-select-input="" name={inputName} type="hidden" value={inputValue} />
    <button class="w-select__trigger" builder-data-element="button" aria-controls={triggerAriaControls} aria-describedby={triggerAriaDescribedby} aria-expanded="false" aria-haspopup="listbox" aria-labelledby={triggerAriaLabelledby} data-select-trigger="" id={triggerId} type="button">
      <span class={`w-select__value ${valueVariant}`} builder-data-element="span" data-select-value="" id={valueId}>{value}</span>
      <svg class="w-select__caret" builder-data-element="svg" aria-hidden="true" viewBox="0 0 16 16"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg>
    </button>
    <div class="w-select__panel" builder-data-element="div" data-select-panel="">
      {(showSearch) && (
        <>
          <div class="w-select__search" builder-data-element="div">
            <svg class="w-select__search-icon" builder-data-element="svg" aria-hidden="true" viewBox="0 0 16 16"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.4"><circle cx="7.25" cy="7.25" r="4.75"></circle><path d="m10.75 10.75 3 3"></path></g></svg>
            <input class="w-select__search-input" builder-data-element="form-input" aria-autocomplete="list" aria-controls="f-region-list" aria-expanded="true" aria-label="Search regions" autocomplete="off" data-select-search="" placeholder="Search regions" role="combobox" spellcheck="false" type="text" />
          </div>
        </>
      )}
      <div class="w-select__viewport" builder-data-element="div">
        <span class="w-select__highlight" builder-data-element="span" aria-hidden="true" data-select-highlight=""></span>
        <ul class="w-select__list" builder-data-element="rich-text" aria-labelledby={listAriaLabelledby} aria-required={listAriaRequired} data-select-list="" id={listId} role="listbox" tabindex="-1"><SiterealRichText html={list} /></ul>
      </div>
      <p class="w-select__empty" builder-data-element="text" data-select-empty="" hidden="">{empty}</p>
    </div>
  </div>
  <div class="w-form-field__footer" builder-data-element="div">
    <p class="w-form-field__hint" builder-data-element="text" id={hintId}>{hint}</p>
    {(showError) && (
      <>
        <p class="w-form-field__error" builder-data-element="text" id="f-region-error">
          <svg class="w-form-field__error-icon" builder-data-element="svg" aria-hidden="true" viewBox="0 0 14 14"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.3"><circle cx="7" cy="7" r="6"></circle><path d="M7 4v3.5"></path></g><circle cx="7" cy="10" fill="currentColor" r=".75"></circle></svg>
          <span class="w-form-field__error-text" builder-data-element="span">{error}</span>
        </p>
      </>
    )}
  </div>
</div>

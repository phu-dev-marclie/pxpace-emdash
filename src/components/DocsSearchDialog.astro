---
import SiterealRichText from './sitereal/RichText.astro';
interface Props {
  results?: string;
}
const { results = "\n<li class=\"w-docs-search-dialog__result\"><a class=\"w-docs-search-dialog__hit\" data-docs-search-hit=\"\" href=\"/docs/quick-start\"><span class=\"w-docs-search-dialog__hit-category\">Quick Start</span><span class=\"w-docs-search-dialog__hit-title\">Set Up Your First Server and Site</span><span class=\"w-docs-search-dialog__hit-excerpt\">Sign up, pick a provider and plan, and get a managed server online in about ten minutes.</span></a></li>\n<li class=\"w-docs-search-dialog__result\"><a class=\"w-docs-search-dialog__hit\" data-docs-search-hit=\"\" href=\"#\"><span class=\"w-docs-search-dialog__hit-category\">Sites</span><span class=\"w-docs-search-dialog__hit-title\">Create a Staging Environment</span><span class=\"w-docs-search-dialog__hit-excerpt\">Clone a live site to a staging domain, test changes, then push them back in one click.</span></a></li>\n<li class=\"w-docs-search-dialog__result\"><a class=\"w-docs-search-dialog__hit\" data-docs-search-hit=\"\" href=\"#\"><span class=\"w-docs-search-dialog__hit-category\">Sites</span><span class=\"w-docs-search-dialog__hit-title\">Install a Free SSL Certificate</span><span class=\"w-docs-search-dialog__hit-excerpt\">Let's Encrypt certificates are issued and renewed automatically for every domain.</span></a></li>\n<li class=\"w-docs-search-dialog__result\"><a class=\"w-docs-search-dialog__hit\" data-docs-search-hit=\"\" href=\"#\"><span class=\"w-docs-search-dialog__hit-category\">Servers</span><span class=\"w-docs-search-dialog__hit-title\">Add a Custom Cron Job</span><span class=\"w-docs-search-dialog__hit-excerpt\">Schedule any command per site or per server, with the output kept in the server log.</span></a></li>\n<li class=\"w-docs-search-dialog__result\"><a class=\"w-docs-search-dialog__hit\" data-docs-search-hit=\"\" href=\"#\"><span class=\"w-docs-search-dialog__hit-category\">Migration</span><span class=\"w-docs-search-dialog__hit-title\">Migrate Sites from cPanel</span><span class=\"w-docs-search-dialog__hit-excerpt\">Move files, databases and email settings from any cPanel host without downtime.</span></a></li>\n<li class=\"w-docs-search-dialog__result\"><a class=\"w-docs-search-dialog__hit\" data-docs-search-hit=\"\" href=\"#\"><span class=\"w-docs-search-dialog__hit-category\">Backup</span><span class=\"w-docs-search-dialog__hit-title\">Restore a Backup to Another Site</span><span class=\"w-docs-search-dialog__hit-excerpt\">Pick any backup point and restore it onto a different site or server.</span></a></li>\n<li class=\"w-docs-search-dialog__result\"><a class=\"w-docs-search-dialog__hit\" data-docs-search-hit=\"\" href=\"#\"><span class=\"w-docs-search-dialog__hit-category\">Developer Tools</span><span class=\"w-docs-search-dialog__hit-title\">Create an API Token</span><span class=\"w-docs-search-dialog__hit-excerpt\">Generate scoped tokens for the public API, the CLI and MCP clients.</span></a></li>\n<li class=\"w-docs-search-dialog__result\"><a class=\"w-docs-search-dialog__hit\" data-docs-search-hit=\"\" href=\"#\"><span class=\"w-docs-search-dialog__hit-category\">Cache</span><span class=\"w-docs-search-dialog__hit-title\">How Page Caching Works</span><span class=\"w-docs-search-dialog__hit-excerpt\">What is cached, when it is purged and how to exclude pages such as the cart.</span></a></li>\n" } = Astro.props;
---
<div class="w-docs-search-dialog" builder-data-element="div" aria-hidden="true" aria-label="Search documentation" aria-modal="true" data-docs-search-dialog="" role="dialog">
  <div class="w-docs-search-dialog__panel" builder-data-element="div">
    <div class="w-docs-search-dialog__field" builder-data-element="div">
      <svg class="w-docs-search-dialog__icon" builder-data-element="svg" aria-hidden="true" viewBox="0 0 20 20"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"><circle cx="9" cy="9" r="5.75"></circle><path d="m13.25 13.25 3.5 3.5"></path></g></svg>
      <input class="w-docs-search-dialog__input" builder-data-element="form-input" aria-label="Search the docs" autocomplete="off" data-docs-search-input="" placeholder="Search the docs…" type="search" />
      <button class="w-docs-search-dialog__close" builder-data-element="button" data-docs-search-close="" type="button">Esc</button>
    </div>
    <ul class="w-docs-search-dialog__results" builder-data-element="rich-text"><SiterealRichText html={results} /></ul>
    <p class="w-docs-search-dialog__empty" builder-data-element="text" data-docs-search-empty="" hidden="">No results for “<span class="w-docs-search-dialog__query" data-docs-search-query=""></span>”. Try another word.</p>
    <div class="w-docs-search-dialog__foot" builder-data-element="div">
      <span class="w-docs-search-dialog__hint" builder-data-element="span"><kbd class="w-docs-search-dialog__key">↑</kbd><kbd class="w-docs-search-dialog__key">↓</kbd>to move</span>
      <span class="w-docs-search-dialog__hint" builder-data-element="span"><kbd class="w-docs-search-dialog__key">↵</kbd>to open</span>
      <span class="w-docs-search-dialog__hint" builder-data-element="span"><kbd class="w-docs-search-dialog__key">esc</kbd>to close</span>
    </div>
  </div>
</div>

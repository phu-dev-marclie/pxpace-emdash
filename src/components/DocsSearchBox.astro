---
interface Props {
  label?: string;
}
const { label = "Search docs" } = Astro.props;
---
<button class="w-docs-search" builder-data-element="button" data-docs-search-open="" type="button">
  <svg class="w-docs-search__icon" builder-data-element="svg" aria-hidden="true" viewBox="0 0 20 20"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"><circle cx="9" cy="9" r="5.75"></circle><path d="m13.25 13.25 3.5 3.5"></path></g></svg>
  <span class="w-docs-search__label" builder-data-element="span">{label}</span>
  <kbd class="w-docs-search__key" data-docs-search-key="">⌘K</kbd>
</button>

---
interface Props {
  link?: string;
  variant?: string;
  label?: string;
  showIcon?: boolean;
}
const { link = "#", variant = "", label = "Book a demo", showIcon = true } = Astro.props;
---
<a class={`w-button-outline ${variant}`} builder-data-element="link" href={link}>
  <span class="w-button-outline__labels" builder-data-element="span">
    <span class="w-button-outline__label" builder-data-element="span">{label}</span>
    <span class="w-button-outline__label-next" builder-data-element="span" aria-hidden="true">{label}</span>
  </span>
  {(showIcon) && (
    <>
      <svg class="w-button-outline__icon" builder-data-element="svg" aria-hidden="true" viewBox="0 0 18 18"><path class="w-button-outline__icon-stem" d="M4.5 9h9.5"></path><path class="w-button-outline__icon-head" d="M6.75 4.5 11.25 9l-4.5 4.5"></path></svg>
    </>
  )}
</a>

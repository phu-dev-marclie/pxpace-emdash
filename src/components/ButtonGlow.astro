---
import SiterealRichText from './sitereal/RichText.astro';
interface Props {
  link?: string;
  icon?: string;
  label?: string;
}
const { link = "#", icon = "<path d=\"M12 1.5l2.4 6.6 6.6 2.4-6.6 2.4L12 19.5l-2.4-6.6L3 10.5l6.6-2.4L12 1.5z\" fill=\"currentColor\"></path><path d=\"M19 15.5l.9 2.6 2.6.9-2.6.9-.9 2.6-.9-2.6-2.6-.9 2.6-.9.9-2.6z\" fill=\"currentColor\"></path>", label = "Ask PXpace AI" } = Astro.props;
---
<a class="w-button-glow" builder-data-element="link" href={link}>
  <span class="w-button-glow__face" builder-data-element="span">
    <svg class="w-button-glow__icon" builder-data-element="rich-text" aria-hidden="true" viewBox="0 0 24 24"><SiterealRichText html={icon} /></svg>
    <span class="w-button-glow__label" builder-data-element="span">{label}</span>
  </span>
</a>

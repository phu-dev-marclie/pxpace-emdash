---
interface Props {
  link?: string;
  variant?: string;
  label?: string;
}
const { link = "#", variant = "", label = "Join for free" } = Astro.props;
---
<a class={`w-button-primary ${variant}`} builder-data-element="link" href={link}>
  <span class="w-button-primary__labels" builder-data-element="span" data-split-chars="w-button-primary__char">
    <span class="w-button-primary__label" builder-data-element="span">{label}</span>
    <span class="w-button-primary__label-next" builder-data-element="span" aria-hidden="true">{label}</span>
  </span>
  <svg class="w-button-primary__icon" builder-data-element="svg" aria-hidden="true" viewBox="0 0 18 18"><path class="w-button-primary__icon-stem" d="M4.5 9h9.5"></path><path class="w-button-primary__icon-head" d="M6.75 4.5 11.25 9l-4.5 4.5"></path></svg>
</a>

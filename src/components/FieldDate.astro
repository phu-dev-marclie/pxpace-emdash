---
interface Props {
  label?: string;
  hint?: string;
  error?: string;
}
const { label = "Go-live date", hint = "We switch DNS on this day. Past days are unavailable.", error = "Pick the day your site goes live." } = Astro.props;
---
<div class="w-form-field" builder-data-element="div" data-field="">
  <label class="w-form-field__label" builder-data-element="form-label" for="f-date" id="f-date-label">
    <span class="w-form-field__label-text" builder-data-element="span">{label}</span>
    <span class="w-form-field__required" builder-data-element="span" aria-hidden="true">*</span>
  </label>
  <div class="w-datepicker" builder-data-element="div" data-datepicker="" data-field-control="" data-min="today" data-required="">
    <input class="w-datepicker__input" builder-data-element="form-input" data-date-input="" name="golive" type="hidden" />
    <button class="w-datepicker__trigger" builder-data-element="button" aria-controls="f-date-panel" aria-describedby="f-date-hint f-date-error" aria-expanded="false" aria-haspopup="dialog" aria-labelledby="f-date-label f-date-value" data-date-trigger="" id="f-date" type="button">
      <svg class="w-datepicker__icon" builder-data-element="svg" aria-hidden="true" viewBox="0 0 18 18"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4"><rect height="11.5" rx="2" width="12.5" x="2.75" y="3.75"></rect><path d="M2.75 7.5h12.5M6 2.25v3M12 2.25v3"></path></g></svg>
      <span class="w-datepicker__value is-placeholder" builder-data-element="span" data-date-value="" id="f-date-value">Pick a date</span>
      <span class="w-datepicker__relative" builder-data-element="span" data-date-relative=""></span>
    </button>
    <div class="w-datepicker__panel" builder-data-element="div" aria-label="Choose the go-live date" aria-modal="false" data-date-panel="" id="f-date-panel" role="dialog">
      <div class="w-datepicker__presets" builder-data-element="div" aria-label="Quick picks" role="group">
        <button class="w-datepicker__preset" builder-data-element="button" data-date-preset="0" type="button">Today</button>
        <button class="w-datepicker__preset" builder-data-element="button" data-date-preset="1" type="button">Tomorrow</button>
        <button class="w-datepicker__preset" builder-data-element="button" data-date-preset="monday" type="button">Next Monday</button>
        <button class="w-datepicker__preset" builder-data-element="button" data-date-preset="7" type="button">In a week</button>
      </div>
      <div class="w-datepicker__header" builder-data-element="div">
        <p class="w-datepicker__month" builder-data-element="text" aria-live="polite" data-date-month="" id="f-date-month">Month</p>
        <div class="w-datepicker__nav-group" builder-data-element="div">
          <button class="w-datepicker__nav" builder-data-element="button" aria-label="Previous month" data-date-prev="" type="button">
            <svg class="w-datepicker__nav-icon w-datepicker__nav-icon--prev" builder-data-element="svg" aria-hidden="true" viewBox="0 0 14 14"><path d="M5 3l4 4-4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"></path></svg>
          </button>
          <button class="w-datepicker__nav" builder-data-element="button" aria-label="Next month" data-date-next="" type="button">
            <svg class="w-datepicker__nav-icon" builder-data-element="svg" aria-hidden="true" viewBox="0 0 14 14"><path d="M5 3l4 4-4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"></path></svg>
          </button>
        </div>
      </div>
      <div class="w-datepicker__grid" builder-data-element="div" aria-labelledby="f-date-month" role="grid">
        <div class="w-datepicker__weekdays" builder-data-element="div" role="row">
          <span class="w-datepicker__weekday" builder-data-element="span" aria-label="Monday" role="columnheader">Mo</span>
          <span class="w-datepicker__weekday" builder-data-element="span" aria-label="Tuesday" role="columnheader">Tu</span>
          <span class="w-datepicker__weekday" builder-data-element="span" aria-label="Wednesday" role="columnheader">We</span>
          <span class="w-datepicker__weekday" builder-data-element="span" aria-label="Thursday" role="columnheader">Th</span>
          <span class="w-datepicker__weekday" builder-data-element="span" aria-label="Friday" role="columnheader">Fr</span>
          <span class="w-datepicker__weekday" builder-data-element="span" aria-label="Saturday" role="columnheader">Sa</span>
          <span class="w-datepicker__weekday" builder-data-element="span" aria-label="Sunday" role="columnheader">Su</span>
        </div>
        <div class="w-datepicker__days" builder-data-element="div" data-date-days="" role="rowgroup"></div>
      </div>
      <div class="w-datepicker__footer" builder-data-element="div">
        <p class="w-datepicker__hint" builder-data-element="text">← → ↑ ↓ move · PgUp / PgDn month</p>
        <button class="w-datepicker__clear" builder-data-element="button" data-date-clear="" type="button">Clear</button>
      </div>
    </div>
  </div>
  <div class="w-form-field__footer" builder-data-element="div">
    <p class="w-form-field__hint" builder-data-element="text" id="f-date-hint">{hint}</p>
    <p class="w-form-field__error" builder-data-element="text" id="f-date-error">
      <svg class="w-form-field__error-icon" builder-data-element="svg" aria-hidden="true" viewBox="0 0 14 14"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.3"><circle cx="7" cy="7" r="6"></circle><path d="M7 4v3.5"></path></g><circle cx="7" cy="10" fill="currentColor" r=".75"></circle></svg>
      <span class="w-form-field__error-text" builder-data-element="span">{error}</span>
    </p>
  </div>
</div>

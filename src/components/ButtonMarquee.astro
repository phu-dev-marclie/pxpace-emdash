---
interface Props {
  link?: string;
  label?: string;
  hoverLabel?: string;
}
const { link = "#", label = "Free migration", hoverLabel = "Let's move it" } = Astro.props;
---
<a class="w-button-marquee" builder-data-element="link" href={link}>
  <span class="w-button-marquee__window" builder-data-element="span">
    <span class="w-button-marquee__track" builder-data-element="span">
      <span class="w-button-marquee__text" builder-data-element="span">{label}</span>
      <span class="w-button-marquee__text" builder-data-element="span" aria-hidden="true">{label}</span>
      <span class="w-button-marquee__text" builder-data-element="span" aria-hidden="true">{label}</span>
      <span class="w-button-marquee__text" builder-data-element="span" aria-hidden="true">{label}</span>
    </span>
  </span>
  <span class="w-button-marquee__swap" builder-data-element="span" aria-hidden="true">{hoverLabel}</span>
</a>

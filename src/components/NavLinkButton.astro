---
interface Props {
  megaTrigger?: string;
  label?: string;
}
const { megaTrigger = "", label = "Solutions" } = Astro.props;
---
<button class="w-nav-link" builder-data-element="button" aria-expanded="false" data-mega-trigger={megaTrigger} type="button">
  <span class="w-nav-link__label" builder-data-element="span">{label}</span>
  <svg class="w-nav-link__caret" builder-data-element="svg" aria-hidden="true" viewBox="0 0 16 16"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg>
</button>

---
interface Props {
  label?: string;
  error?: string;
}
const { label = "Admin password", error = "At least 8 characters." } = Astro.props;
---
<div class="w-form-field" builder-data-element="div" data-field="">
  <label class="w-form-field__label" builder-data-element="form-label" for="f-pass">
    <span class="w-form-field__label-text" builder-data-element="span">{label}</span>
    <span class="w-form-field__required" builder-data-element="span" aria-hidden="true">*</span>
  </label>
  <div class="w-input" builder-data-element="div" data-field-control="">
    <svg class="w-input__icon" builder-data-element="svg" aria-hidden="true" viewBox="0 0 18 18"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4"><rect height="7.5" rx="2" width="11" x="3.5" y="8"></rect><path d="M6 8V5.75a3 3 0 0 1 6 0V8"></path></g></svg>
    <input class="w-input__field" builder-data-element="form-input" aria-describedby="f-pass-meter f-pass-error" autocomplete="new-password" id="f-pass" minlength="8" name="password" placeholder="8+ characters" required="" type="password" />
    <button class="w-input__reveal" builder-data-element="button" aria-label="Show password" aria-pressed="false" data-reveal="" type="button">
      <svg class="w-input__reveal-icon" builder-data-element="svg" aria-hidden="true" viewBox="0 0 18 18"><path class="w-input__reveal-eye" d="M1.5 9c1.6-3.3 4.4-5.25 7.5-5.25S14.9 5.7 16.5 9c-1.6 3.3-4.4 5.25-7.5 5.25S3.1 12.3 1.5 9Z"></path><circle class="w-input__reveal-pupil" cx="9" cy="9" r="2.25"></circle><path class="w-input__reveal-slash" d="M3 3l12 12"></path></svg>
    </button>
  </div>
  <div class="w-meter" builder-data-element="div" data-meter="f-pass" data-meter-labels="Too weak: make it 8+ characters|Fair: add a number or a symbol|Good: a few more characters|Strong password">
    <span class="w-meter__bar" builder-data-element="span"></span>
    <span class="w-meter__bar" builder-data-element="span"></span>
    <span class="w-meter__bar" builder-data-element="span"></span>
    <span class="w-meter__bar" builder-data-element="span"></span>
    <span class="w-meter__label" builder-data-element="span" aria-live="polite" data-meter-label="" id="f-pass-meter">Use 8+ characters with a number and a symbol.</span>
  </div>
  <div class="w-form-field__footer" builder-data-element="div">
    <p class="w-form-field__error" builder-data-element="text" id="f-pass-error">
      <svg class="w-form-field__error-icon" builder-data-element="svg" aria-hidden="true" viewBox="0 0 14 14"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.3"><circle cx="7" cy="7" r="6"></circle><path d="M7 4v3.5"></path></g><circle cx="7" cy="10" fill="currentColor" r=".75"></circle></svg>
      <span class="w-form-field__error-text" builder-data-element="span">{error}</span>
    </p>
  </div>
</div>

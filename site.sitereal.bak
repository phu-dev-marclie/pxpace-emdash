            "color": "neutral",
            "on": true,
            "builtin": true
          },
          {
            "id": "success",
            "label": "Success",
            "kind": "color",
            "color": "success",
            "on": true,
            "builtin": true
          },
          {
            "id": "warning",
            "label": "Warning",
            "kind": "color",
            "color": "warning",
            "on": true,

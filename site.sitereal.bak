      "textWeight": 400,
      "textLineHeight": "1.6",
      "headingWeight": 700,
      "headingLineHeight": "1.1",
      "headingColor": "var(--base-400)",
      "spaceMinSize": 16,
      "spaceMinRatio": 1.5,
      "spaceMaxSize": 24,
      "spaceMaxRatio": 1.5,
      "sectionMinSize": 48,
      "sectionMinRatio": 1.5,
      "sectionMaxSize": 80,
      "sectionMaxRatio": 1.5,
      "contentWidth": "80rem",
      "containerSpacing": "var(--space-l)",
      "contentSpacing": "var(--space-m)",
      "layoutFluid": false,
      "contentWidthMin": 640,
      "contentWidthMax": 1280,
      "borderWidth": "1px",
      "borderLight": "var(--neutral-200)",
      "borderDark": "var(--neutral-400)",
      "elementStyles": {},
      "buttons": {
        "baseClass": "btn",
        "tokens": {},
        "variants": [
          {
            "id": "primary",
            "label": "Primary",
